{
  "name": "@testrelic/mcp",
  "version": "3.4.2",
  "description": "TestRelic MCP Server \u2014 cloud-wired intelligent testing context (test creation, auto-healing, coverage gaps, test impact). One token; everything else is resolved.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-server-testrelic": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "types": "./dist/config.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    ".agents/skills/**/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "dev:http": "tsx src/cli.ts --port 3000",
    "update-readme": "node scripts/update-readme.js",
    "copy-config": "node scripts/copy-config.js",
    "roll": "npm run copy-config && npm run update-readme && npm run update-skill && npm run mirror-skills",
    "update-skill": "node scripts/update-skill.js",
    "mirror-skills": "node scripts/mirror-skills.js",
    "check-skills": "node scripts/mirror-skills.js --check",
    "prepack": "node scripts/mirror-skills.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "axios": "^1.20.0",
    "diff": "^8.0.3",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "gpt-tokenizer": "^4.0.0",
    "lru-cache": "^11.0.2",
    "p-queue": "^8.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.2.0",
    "yargs": "^18.2.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^13.0.3",
    "hnswlib-node": "^3.0.0",
    "tree-sitter": "^0.25.1",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.3",
    "@types/yargs": "^17.0.33",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "testrelic",
    "testing",
    "playwright",
    "coverage",
    "ai"
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/testrelic-ai/testrelic-mcp-server.git"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
