#!/usr/bin/env bash
# supply-chain-guard self-test: synthesizes every fixture at runtime (one temp git repo per case)
# and runs the whole suite once per locale: C, POSIX and every UTF-8 locale `locale -a` lists.
# Usage: tests/run [case-name ...]      Env: SELFTEST_JOBS (parallel cases, default 6)
set -u
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || exit 2
command -v python3 >/dev/null 2>&1 || { echo "tests/run: python3 not found"; exit 2; }
command -v git >/dev/null 2>&1 || { echo "tests/run: git not found"; exit 2; }

locales="C POSIX"
if command -v locale >/dev/null 2>&1; then
  utf8=$(locale -a 2>/dev/null | grep -Ei 'utf-?8' | sort -u | tr '\n' ' ')
  locales="$locales $utf8"
fi
echo "tests/run: locales under test: $locales"
[ -n "${utf8:-}" ] || echo "tests/run: note: no UTF-8 locale installed; only C and POSIX are tested"

fail=0; total_pass=0; total_fail=0; ran=""
for loc in $locales; do
  out=$(LC_ALL="$loc" LANG="$loc" python3 -I -B "$here/selftest.py" "$loc" "$@" 2>&1)
  rc=$?
  printf '%s\n' "$out" | grep -v '^ok ' || true
  res=$(printf '%s\n' "$out" | grep '^RESULT ' | tail -1)
  p=$(printf '%s' "$res" | sed -n 's/.*passed=\([0-9]*\).*/\1/p'); f=$(printf '%s' "$res" | sed -n 's/.*failed=\([0-9]*\).*/\1/p')
  total_pass=$(( total_pass + ${p:-0} )); total_fail=$(( total_fail + ${f:-0} ))
  if [ "$rc" -ne 0 ] || [ -z "$res" ]; then fail=1; fi
  ran="$ran $loc"
done
echo "tests/run: locales:$ran | passed=$total_pass failed=$total_fail"
[ "$fail" -eq 0 ] && echo "tests/run: PASS" || echo "tests/run: FAIL"
exit "$fail"
