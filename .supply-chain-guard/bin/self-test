#!/usr/bin/env bash
# supply-chain-guard: self-test (thin wrapper; the logic lives in lib/guard/).
# Runs every check's built-in canary (P, S and C) and nothing else; seconds, not minutes.
# Exit status: 0 every canary detected its positive and passed its negative sample, 2 otherwise.
set -u
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || {
  echo "self-test: COULD NOT SCAN: cannot resolve the install directory"; exit 2; }
command -v python3 >/dev/null 2>&1 || { echo "self-test: COULD NOT SCAN: python3 not found"; exit 2; }
command -v git >/dev/null 2>&1 || { echo "self-test: COULD NOT SCAN: git not found"; exit 2; }
python3 -I -B "$here/../lib/guard/main.py" self-test "$@"
rc=$?
case $rc in 0) exit 0 ;; *) [ "$rc" -eq 2 ] || echo "self-test: COULD NOT SCAN: interpreter exited $rc"; exit 2 ;; esac
