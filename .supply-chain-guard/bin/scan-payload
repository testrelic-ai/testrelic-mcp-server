#!/usr/bin/env bash
# supply-chain-guard: scan-payload (thin wrapper; the logic lives in lib/guard/).
# Exit status: 0 clean, 1 findings, 2 could not scan. Never fails open.
set -u
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || {
  echo "scan-payload: COULD NOT SCAN: cannot resolve the install directory"; exit 2; }
command -v python3 >/dev/null 2>&1 || { echo "scan-payload: COULD NOT SCAN: python3 not found"; exit 2; }
command -v git >/dev/null 2>&1 || { echo "scan-payload: COULD NOT SCAN: git not found"; exit 2; }
# -I: ignore PYTHON* env vars and user site-packages; -B: never write .pyc into the action dir
python3 -I -B "$here/../lib/guard/main.py" scan-payload "$@"
rc=$?
case $rc in 0|1|2) exit $rc ;; *) echo "scan-payload: COULD NOT SCAN: interpreter exited $rc"; exit 2 ;; esac
