#!/usr/bin/env bash
# supply-chain-guard: adoption-patch (rollout helper; not part of the action's checks).
# Makes the adoption change in a clean working tree: deletes the legacy in-repo scanner, repoints
# the steps that ran it at the vendored local copy (.supply-chain-guard/), stages it, re-checks.
# Exit status: 0 the changed tree passes, 1 work remains, 2 could not run.
set -u
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || {
  echo "adoption-patch: COULD NOT RUN: cannot resolve the install directory"; exit 2; }
command -v python3 >/dev/null 2>&1 || { echo "adoption-patch: COULD NOT RUN: python3 not found"; exit 2; }
command -v git >/dev/null 2>&1 || { echo "adoption-patch: COULD NOT RUN: git not found"; exit 2; }
python3 -I -B "$here/adoption_patch.py" "$@"
rc=$?
case $rc in 0|1|2) exit $rc ;; *) echo "adoption-patch: COULD NOT RUN: interpreter exited $rc"; exit 2 ;; esac
